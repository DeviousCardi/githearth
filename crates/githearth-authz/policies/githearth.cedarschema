// GitHearth authorization schema. See docs/decisions/0002-authorization.md.
//
// Entity parents carry the hierarchy that role templates match with `in`:
// an account is in its teams and organizations, a team in its parent team
// and organization, a repository in its organization, and every
// repository-owned object in its repository. Attributes that policies read
// across the hierarchy (suspension, visibility, archival, branch
// protection) are copied onto each entity by the engine from loaded facts.

namespace GitHearth {
  // Request context, always filled by the engine and never by the caller.
  // auth_age_seconds is the time since the account last presented its
  // password; fresh_auth_seconds is the engine's sudo-mode window.
  type Auth = { auth_age_seconds: Long, fresh_auth_seconds: Long };
  type MergeAuth = {
    auth_age_seconds: Long,
    fresh_auth_seconds: Long,
    approvals: Long,
    checks_passed: Bool,
    code_owner_review_ok: Bool,
  };

  // Unauthenticated visitor: no attributes, no parents.
  entity Anonymous;
  // The instance: the resource for site administration that is not scoped to an
  // organization (account provisioning and lifecycle). It has no attributes and
  // no parents; only the caller's site-administrator fact and the built-in
  // site-admin policies decide it.
  entity Instance;
  entity Organization = {
    suspended: Bool,
  };
  entity Team in [Team, Organization] = {
    organization: Organization,
  };
  entity Account in [Team, Organization] = {
    suspended: Bool,
    site_admin: Bool,
  };
  // visibility: "public", "internal" (members of the owning organization) or "private".
  entity Repository in [Organization] = {
    organization: Organization,
    visibility: String,
    archived: Bool,
  };
  // A branch or tag. Unprotected refs have protected == false and the
  // remaining protection fields at their permissive values. `exists` is false
  // only while the ref is being created (old oid all zeros).
  entity Ref in [Repository] = {
    organization: Organization,
    repository: Repository,
    protected: Bool,
    allow_force_push: Bool,
    allow_deletion: Bool,
    require_pull_request: Bool,
    required_approvals: Long,
    require_checks: Bool,
    require_code_owner_review: Bool,
    exists: Bool,
  };
  entity Issue in [Repository] = {
    organization: Organization,
    repository: Repository,
    author: Account,
  };
  entity PullRequest in [Repository] = {
    organization: Organization,
    repository: Repository,
    author: Account,
    target: Ref,
  };

  // Action groups. Role templates name groups, never single actions, so a
  // new action joins its group here and no template changes.
  action "public_read";
  action "member";
  action "read";
  action "triage";
  action "write";
  action "maintain";
  action "admin";
  action "owner";
  action "site_admin";
  // Sudo mode: an action that is also in "sensitive" changes access,
  // administers or destroys, and needs a recent authentication (see the
  // fresh-auth forbid in builtin.cedar).
  action "sensitive";

  // Organization
  action "organization.read" in ["member", "read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "repository.create" in ["member"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "organization.update" in ["owner", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "organization.manage_members" in ["owner", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "organization.delete" in ["owner", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "team.create" in ["owner", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "organization.suspend" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };
  action "organization.unsuspend" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Organization,
      context: Auth,
    };

  // Instance administration: account provisioning and lifecycle belong to site
  // administrators alone (see the `site-admin-only` forbid in builtin.cedar).
  action "account.read" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Instance,
      context: Auth,
    };
  action "account.create" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Instance,
      context: Auth,
    };
  action "account.disable" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Instance,
      context: Auth,
    };
  action "account.enable" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Instance,
      context: Auth,
    };
  action "account.reset_password" in ["site_admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Instance,
      context: Auth,
    };

  // Repository
  action "repository.read" in ["public_read", "read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "repository.clone" in ["public_read", "read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "issue.create" in ["read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "pull_request.create" in ["read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "repository.update" in ["maintain"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "repository.manage_access" in ["admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "repository.archive" in ["admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "repository.unarchive" in ["admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "repository.delete" in ["admin", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };
  action "status.create" in ["write"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Repository,
      context: Auth,
    };

  // Refs
  action "ref.push" in ["write"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Ref,
      context: Auth,
    };
  action "ref.force_push" in ["write", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Ref,
      context: Auth,
    };
  action "ref.delete" in ["write", "sensitive"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Ref,
      context: Auth,
    };

  // Issues
  action "issue.read" in ["public_read", "read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Issue,
      context: Auth,
    };
  action "issue.comment" in ["read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Issue,
      context: Auth,
    };
  action "issue.label" in ["triage"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Issue,
      context: Auth,
    };
  action "issue.assign" in ["triage"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Issue,
      context: Auth,
    };
  action "issue.close" in ["triage"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: Issue,
      context: Auth,
    };

  // Pull requests
  action "pull_request.read" in ["public_read", "read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: PullRequest,
      context: Auth,
    };
  action "pull_request.comment" in ["read"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: PullRequest,
      context: Auth,
    };
  action "pull_request.close" in ["triage"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: PullRequest,
      context: Auth,
    };
  action "pull_request.approve" in ["write"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: PullRequest,
      context: Auth,
    };
  // approvals and checks_passed are computed by the service for the exact
  // head and target revisions being merged, never taken from the caller.
  action "pull_request.merge" in ["write"]
    appliesTo {
      principal: [Account, Anonymous],
      resource: PullRequest,
      context: MergeAuth,
    };
}
